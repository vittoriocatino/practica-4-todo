{
  "widgets": [
    {"type":"metric","x":0,"y":0,"width":24,"height":6,"properties":{
      "title":"EC2 CPU (%) - native AWS metric","view":"timeSeries","region":"${region}",
      "period":60,"stat":"Average","metrics":[["AWS/EC2","CPUUtilization","InstanceId","${instance_id}"]],
      "annotations":{"horizontal":[{"label":"Alarm >= 80% (2 min)","value":80}]}}},
    {"type":"metric","x":0,"y":6,"width":12,"height":6,"properties":{
      "title":"RDS errors - instrumented via boto3","view":"timeSeries","region":"${region}",
      "period":60,"stat":"Sum","metrics":[["TodoList","DatabaseErrors","Application","${app_name}"]],
      "annotations":{"horizontal":[{"label":"Alarm >= 1 error","value":1}]}}},
    {"type":"metric","x":12,"y":6,"width":12,"height":6,"properties":{
      "title":"Database operation latency (ms) - instrumented","view":"timeSeries","region":"${region}",
      "period":60,"stat":"Average","metrics":[["TodoList","DatabaseLatency","Application","${app_name}"]],
      "annotations":{"horizontal":[{"label":"Alarm >= 500 ms (2 min)","value":500}]}}}
  ]
}
